{
  "name": "@officer-election/server",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/db/migrate.ts && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@officer-election/shared": "workspace:*",
    "@trpc/server": "^10.45.4",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.36.4",
    "express": "^4.22.2",
    "nanoid": "^5.1.11",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22.19.21",
    "@types/qs": "^6.15.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
